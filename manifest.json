{
  "manifest_version": 3,
  "name": "Note81x - Operational Filter",
  "version": "3.0.1",
  "description": "Filters academic text into operational notes using DeepSeek.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.hackthebox.com/*",
    "http://127.0.0.1:8080/*",
    "http://localhost:8080/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "note81x@local.internal"
    }
  }
}